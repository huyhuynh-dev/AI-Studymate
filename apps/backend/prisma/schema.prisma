generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  password_hash String?        @db.VarChar(255)
  name          String         @db.VarChar(255)
  avatar_url    String?        @db.VarChar(500)
  role          String         @default("user") @db.VarChar(20)
  is_active     Boolean        @default(true)
  is_verified   Boolean        @default(false)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  provider      String?        @db.VarChar(20)
  provider_id   String?        @db.VarChar(255)
  refresh_token String?        @db.VarChar(500)
  subjects      Subject[]
  conversations Conversation[]
  documents     Document[]

  @@map("users")
}

model Subject {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @db.VarChar(255)
  color      String?  @db.VarChar(7)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  conversations Conversation[]

  @@map("subjects")
}

model Conversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_id String   @db.Uuid
  user_id    String   @db.Uuid
  title      String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  documents Document[]

  @@map("conversations")
}

model Document {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String   @db.Uuid
  user_id         String   @db.Uuid
  file_name       String   @db.VarChar(500)
  file_type       String   @db.VarChar(50) // 'pdf' | 'image'
  file_size       BigInt   @db.BigInt // bytes
  storage_key     String   @db.VarChar(1000) // key trên R2/MinIO
  raw_text        String?  @db.Text // text đã extract
  ocr_status      String   @default("pending") @db.VarChar(20) // 'pending'|'processing'|'done'|'failed'
  embed_status    String   @default("pending") @db.VarChar(20) // 'pending'|'processing'|'done'|'failed'
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  conversation Conversation    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String                       @db.Uuid
  chunk_index Int
  content     String                       @db.Text
  embedding   Unsupported("vector(1536)")? // pgvector; dimension phụ thuộc model
  created_at  DateTime                     @default(now()) @db.Timestamptz(6)

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  // INDEX ON embedding USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100)
  @@map("document_chunks")
}
